# Modèle des variables d'environnement du projet billetterie.
# Copier ce fichier en .env puis renseigner les valeurs localement.
# Ne jamais commiter .env ni mettre de valeur réelle dans ce fichier.

# --- PostgreSQL (une base par service) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

# --- Redis (cache du catalogue, verrous des places) ---
REDIS_URL=

# --- RabbitMQ (exchange topic "ticketing") ---
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
RABBITMQ_URL=

# --- Keycloak (realm "billetterie") ---
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REALM=billetterie

# --- Consul ---
CONSUL_HTTP_ADDR=
