{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://billetterie.exemple.test/evenements/ticketing.order.expired.json",
  "title": "ticketing.order.expired",
  "description": "Une commande n'est pas payée (refus ou délai dépassé) ; ses places sont libérées. Émetteur : Commandes. Consommateurs : Billets. Enveloppe commun.evenements.Evenement, publiée par l'outbox.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Identifiant unique du message (idempotence des consommateurs)."
    },
    "type": {
      "const": "ticketing.order.expired"
    },
    "version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "commande_id": {
          "type": "string",
          "format": "uuid"
        },
        "seance_id": {
          "type": "string",
          "format": "uuid"
        },
        "place_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "required": [
        "commande_id",
        "seance_id",
        "place_ids"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "occurred_at",
    "correlation_id",
    "data"
  ],
  "additionalProperties": false
}
