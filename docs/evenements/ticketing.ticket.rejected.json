{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://billetterie.exemple.test/evenements/ticketing.ticket.rejected.json",
  "title": "ticketing.ticket.rejected",
  "description": "Billets refuse d'émettre les billets d'une commande confirmée (une place déjà vendue ou séance annulée) : aucun billet n'est émis pour la commande, qui est remboursée. Émetteur : Billets. Consommateurs : Paiements, Notifications. Enveloppe commun.evenements.Evenement, publiée par l'outbox.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Identifiant unique du message (idempotence des consommateurs)."
    },
    "type": {
      "const": "ticketing.ticket.rejected"
    },
    "version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "commande_id": {
          "type": "string",
          "format": "uuid"
        },
        "seance_id": {
          "type": "string",
          "format": "uuid"
        },
        "place_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "description": "Places en conflit pour PLACE_DEJA_VENDUE ; toutes les places de la commande pour SEANCE_ANNULEE."
        },
        "motif": {
          "enum": [
            "PLACE_DEJA_VENDUE",
            "SEANCE_ANNULEE"
          ]
        }
      },
      "required": [
        "commande_id",
        "seance_id",
        "place_ids",
        "motif"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "occurred_at",
    "correlation_id",
    "data"
  ],
  "additionalProperties": false
}
