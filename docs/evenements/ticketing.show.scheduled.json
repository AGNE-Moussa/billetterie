{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://billetterie.exemple.test/evenements/ticketing.show.scheduled.json",
  "title": "ticketing.show.scheduled",
  "description": "Une séance est programmée ; Billets crée ses places, Notifications garde son intitulé, sa date et son lieu. Émetteur : Catalogue. Consommateurs : Billets, Notifications. Enveloppe commun.evenements.Evenement, publiée par l'outbox.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Identifiant unique du message (idempotence des consommateurs)."
    },
    "type": {
      "const": "ticketing.show.scheduled"
    },
    "version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "seance_id": {
          "type": "string",
          "format": "uuid"
        },
        "evenement_id": {
          "type": "string",
          "format": "uuid"
        },
        "evenement_nom": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "lieu_id": {
          "type": "string",
          "format": "uuid"
        },
        "lieu_nom": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "ville": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "debut": {
          "type": "string",
          "format": "date-time"
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "categorie_id": {
                "type": "string",
                "format": "uuid"
              },
              "nom": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "prix": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "description": "Montant en centimes."
              },
              "rangs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "rang": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 10
                    },
                    "nombre_places": {
                      "type": "integer",
                      "minimum": 1,
                      "description": "Places numérotées de 1 à nombre_places.",
                      "maximum": 1000
                    }
                  },
                  "required": [
                    "rang",
                    "nombre_places"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 100
              }
            },
            "required": [
              "categorie_id",
              "nom",
              "prix",
              "rangs"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        }
      },
      "required": [
        "seance_id",
        "evenement_id",
        "evenement_nom",
        "lieu_id",
        "lieu_nom",
        "ville",
        "debut",
        "categories"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "occurred_at",
    "correlation_id",
    "data"
  ],
  "additionalProperties": false
}
